              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"diego.leal@medivoz.com\",\n  \"password\": \"Medivoz@2026\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Login correcto', () => pm.expect(r.success).to.be.true);",
                  "pm.collectionVariables.set('token', r.data.token);",
                  "pm.collectionVariables.set('medicoId', r.data.usuario._id);"
                ]
              }
            }
          ]
        },

# Copia este archivo como .env y llena tus valores reales.
# El archivo .env NUNCA se sube a GitHub.

PORT=3000

# Cadena de conexión de MongoDB Atlas (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/medivoz?retryWrites=true&w=majority

# Clave para firmar los tokens JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES_IN=8h

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173
